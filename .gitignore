# Editor / app-generated backup snapshots
*.bak

# btop rewrites this on exit; never hand-edited
.config/btop/btop.conf

# fish universal-variable store: machine state + hardcoded $HOME paths
.config/fish/fish_variables

# Auto-generated by `systemctl --user enable` (tracked as a symlink)
.config/systemd/user/*.target.wants/

# Empty qutebrowser state files, recreated by the app
.config/qutebrowser/bookmarks/urls
.config/qutebrowser/quickmarks
