    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-btw",
    "npm:@narumitw/pi-caffeinate",
    "npm:@narumitw/pi-plan-mode",
    "npm:@gotgenes/pi-permission-system",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "quietStartup": true,
  "defaultProjectTrust": "always",
  "tuiMode": "regular"
}